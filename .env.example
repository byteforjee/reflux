# ──────────────────────────────────────────────────────────────────────────────
# Reflux — Environment Variables
# Copy this file to .env.local and fill in values.
# Never commit .env.local or any file containing real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon or Supabase recommended — see progress-tracker.md)
# The database is a STAGING/CACHE layer only. Onchain state is always authoritative.
DATABASE_URL=

# ─── Anthropic (Claude API) ───────────────────────────────────────────────────
# Used for invoice risk scoring (lib/ai/) and the Reflux chatbot widget.
# API calls only happen in app/api/ route handlers — never from client components.
GEMINI_API_KEY=

# ─── IPFS / Pinata ────────────────────────────────────────────────────────────
# Used to pin uploaded invoice documents. Only the CID is written onchain or
# stored in the database — the raw document binary never touches either.
# (Provider choice: Pinata vs. web3.storage — see progress-tracker.md open questions)
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_JWT=

# ─── Backend Oracle / Admin Signing Key ───────────────────────────────────────
# Private key of the wallet authorized to write scores to RiskOracle onchain
# and to trigger the simulated repayment action.
# SECURITY: This key must never be exposed to the client. Only used in app/api/.
# This is an acknowledged hackathon-scale design — not a production key management system.
ORACLE_PRIVATE_KEY=

# ─── Admin Wallet Allowlist ───────────────────────────────────────────────────
# Comma-separated Ethereum wallet addresses that can access the admin/ops panel.
# Gating mechanism: hardcoded allowlist (architecture.md — Auth and Access Model).
# This is an explicit hackathon shortcut, not a real permissions system.
ADMIN_WALLET_ALLOWLIST=

# ─── X Layer RPC Endpoints ────────────────────────────────────────────────────
# Override these if you have a private/dedicated RPC endpoint.
# Defaults (used if these are blank): testrpc.xlayer.tech and rpc.xlayer.tech
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech

# ─── Public Client-Side Vars (NEXT_PUBLIC_ prefix — exposed to the browser) ──
# These are safe to expose; they are just chain IDs and RPC URLs, not secrets.
NEXT_PUBLIC_XLAYER_CHAIN_ID_TESTNET=195
NEXT_PUBLIC_XLAYER_CHAIN_ID_MAINNET=196
NEXT_PUBLIC_XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech
NEXT_PUBLIC_XLAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech
